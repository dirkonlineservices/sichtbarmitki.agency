---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Kontakt | sichtbarmitKi.agency"
  description="Treten Sie mit uns in Kontakt: Vereinbaren Sie Ihr persönliches Kennenlerngespräch rund um KI-Sichtbarkeit, Webumsetzung, SEO und Tracking."
>
  <!-- Header Section -->
  <section class="relative pt-24 pb-16 md:pt-32 md:pb-20 border-b border-slate-800/80 bg-gradient-to-b from-slate-950 via-slate-900/60 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-6">
        Wir sind für Sie da
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight">
        Lassen Sie uns <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300">sprechen</span>
      </h1>
      <p class="mt-6 text-lg text-slate-300 leading-relaxed">
        Schreiben Sie uns oder rufen Sie direkt an, um Ihre Sichtbarkeit mit KI gezielt zu steigern. Wir freuen uns auf Ihr Vorhaben!
      </p>
    </div>
  </section>

  <!-- Contact Details & Form Grid -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Side: Contact Information Cards -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-8 shadow-xl">
            <h3 class="text-xl font-bold text-white mb-6">Direkte Kontaktdaten</h3>
            
            <div class="space-y-6">
              <!-- Person / Company -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-white">DS Online Services</h4>
                  <p class="text-sm text-slate-400">Inhaber: Dirk Schmetzer</p>
                  <p class="text-xs text-slate-500 mt-0.5">Riedgrasweg 30, 70599 Stuttgart</p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-white">Telefon & WhatsApp</h4>
                  <a href="tel:+4915906122744" class="text-sm text-blue-400 hover:underline">
                    +49 1590 6122744
                  </a>
                  <p class="text-xs text-slate-500 mt-0.5">Mo. – Fr. von 09:00 bis 18:00 Uhr</p>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-white">E-Mail-Kontakt</h4>
                  <a href="mailto:hallo@sichtbarmitki.agency" class="text-sm text-blue-400 hover:underline block">
                    hallo@sichtbarmitki.agency
                  </a>
                  <a href="mailto:dirk.online.services@gmail.com" class="text-xs text-slate-400 hover:underline block mt-0.5">
                    dirk.online.services@gmail.com
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Fast response guarantee -->
          <div class="bg-gradient-to-tr from-blue-900/20 to-indigo-900/20 border border-blue-500/30 rounded-2xl p-6">
            <h4 class="text-sm font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-emerald-400 font-bold text-base">⚡</span>
              Reaktionszeit-Garantie
            </h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Jede Anfrage wird innerhalb von maximal 24 Stunden persönlich von Dirk Schmetzer beantwortet – unkompliziert, direkt und zielorientiert.
            </p>
          </div>
        </div>

        <!-- Right Side: Form -->
        <div class="lg:col-span-7">
          <ContactForm
            title="Jetzt Nachricht senden"
            subtitle="Füllen Sie einfach die Felder aus. Wir melden uns umgehend bei Ihnen zurück."
          />
        </div>

      </div>
    </div>
  </section>
</Layout>
