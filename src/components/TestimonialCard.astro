---
interface Props {
  quote: string;
  author: string;
  role?: string;
  rating?: number;
}

const { quote, author, role = "Unternehmer/in", rating = 5 } = Astro.props;
---

<div class="relative bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-8 flex flex-col justify-between hover:border-slate-700 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/5 group">
  <!-- Top Quote Icon & Stars -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <!-- Stars -->
      <div class="flex items-center gap-1 text-amber-400">
        {Array.from({ length: rating }).map(() => (
          <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <svg class="w-8 h-8 text-slate-700 group-hover:text-blue-500/30 transition-colors" fill="currentColor" viewBox="0 0 32 32">
        <path d="M10 8c-3.3 0-6 2.7-6 6v10h10V14h-6c0-2.2 1.8-4 4-4V8zm14 0c-3.3 0-6 2.7-6 6v10h10V14h-6c0-2.2 1.8-4 4-4V8z"/>
      </svg>
    </div>

    <!-- Quote -->
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed italic mb-6">
      „{quote}“
    </p>
  </div>

  <!-- Author Info -->
  <div class="flex items-center gap-3 pt-4 border-t border-slate-800/80">
    <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center font-bold text-white text-sm shadow-md">
      {author.charAt(0)}
    </div>
    <div>
      <h4 class="text-sm font-semibold text-white">{author}</h4>
      <p class="text-xs text-slate-400">{role}</p>
    </div>
  </div>
</div>
